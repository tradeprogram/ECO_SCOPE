# Google Earth Engine — 위성 판독에 필수
# `earthengine authenticate` 로 인증한 뒤, 사용할 클라우드 프로젝트 ID 를 넣는다.
EE_PROJECT=

# 국립생태원 생태자연도 오픈API (공공데이터포털, 자동승인, 개발계정 일 10,000회)
# https://www.data.go.kr/data/15057288/openapi.do
DATA_GO_KR_KEY=

# 에코뱅크 자체 발급 키가 따로 있으면 여기에. 없으면 비워둔다.
ECOBANK_API_KEY=

# 기상청 관측·예보 (선택)
KMA_API_KEY=

# 질의응답 서버
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
